# Copy to supabase/.env.local (gitignored). Read by `supabase start` (auth providers) and
# `supabase functions serve --env-file supabase/.env.local` (edge function secrets).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
OPENAI_API_KEY=
REVENUECAT_API_KEY=
# Optional model overrides (defaults in supabase/functions/_shared/openai.ts)
OPENAI_LIVE_MODEL=
OPENAI_LIVE_VOICE=
OPENAI_REVIEW_MODEL=
# Reading texts: the writer needs judgement, the helper does bulk extraction the validator
# checks anyway — so they are deliberately different models (docs/lesetext-plan.md §6).
OPENAI_READING_WRITER_MODEL=
OPENAI_READING_HELPER_MODEL=
