# Copy to supabase/.env.local (gitignored). Read by `supabase start` (auth providers) and
# `supabase functions serve --env-file supabase/.env.local` (edge function secrets).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
OPENAI_API_KEY=
REVENUECAT_API_KEY=
# Optional overrides for the live call (defaults in supabase/functions/_shared/openai.ts)
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_REVIEW_MODEL=
