{
  "expo": {
    "name": "Yori",
    "slug": "yori",
    "version": "1.0.0",
    "scheme": "yori",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yori",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Yori uses the microphone so you can talk to Pip."
      }
    },
    "android": {
      "package": "app.yori",
      "adaptiveIcon": {
        "backgroundColor": "#e7e5fe",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e7e5fe"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yori uses your photos so you can pick a profile picture."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Yori does not use the camera.",
          "microphonePermission": "Yori uses the microphone so you can talk to Pip."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
