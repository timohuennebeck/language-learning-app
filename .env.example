# Copy to .env.local (gitignored). Publishable keys (sb_publishable_…) are safe to ship in the app
# bundle; secret keys (sb_secret_…) never leave the server (edge functions get them injected).

# Local stack (`npm run db:start`, values from `supabase status`):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

